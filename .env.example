# API key protecting mutating routes (unset = demo mode, routes open)
API_KEY=

# Server port (defaults to 3005)
PORT=3005

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3005

# Supabase PostgREST persistence: set BOTH to persist to Supabase;
# leave both unset to use local sql.js SQLite (dev).
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
